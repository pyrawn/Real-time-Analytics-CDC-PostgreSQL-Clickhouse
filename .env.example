# Copy to .env and fill in. Never commit the real .env.

POSTGRES_DB=ecommerce
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

REPLICATOR_USER=replicator
REPLICATOR_PASSWORD=changeme

CLICKHOUSE_DB=ecommerce
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=changeme

# generator/ (Julio, Part 1)
# Values used for the benchmark run: ~200k INSERT/UPDATE/DELETE in about half an hour.
# GEN_DURATION_SECONDS=0 keeps the generator running, so there is live data for the
# benchmark and the dashboard.
GEN_RATE_PER_SEC=100
GEN_DURATION_SECONDS=0

# peerdb/ (Valeria, Part 2) — add whatever PeerDB's compose stack needs here
# (Nota: Los servicios internos de PeerDB como minio o su catálogo fueron configurados directamente en docker-compose.yml mediante anchors, no requieren variables extra).
